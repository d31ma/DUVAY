{
  "$description": "DuVay Select — Core contract, tier 1.",
  "name": "Select",
  "tier": 1,
  "names": {
    "web": "w-select",
    "apple": "DuVayPicker",
    "android": "DuVayDropdown",
    "windows": "DuVayComboBox",
    "linux": "duvay_combo_row"
  },
  "accessibility": {
    "role": "combobox",
    "nameFrom": [
      "label",
      "text",
      "slotted content",
      "aria-label"
    ]
  },
  "states": [
    "default",
    "hover",
    "focus-visible",
    "pressed",
    "disabled",
    "loading",
    "readonly",
    "error"
  ],
  "props": {
    "active": {
      "type": "boolean",
      "default": false,
      "description": "render the highlighted/active state"
    },
    "active-color": {
      "type": "string"
    },
    "append-icon": {
      "type": "string"
    },
    "append-inner-icon": {
      "type": "string"
    },
    "autocomplete": {
      "type": "string",
      "description": "`autocomplete` for the hidden input (`suppress` == off)"
    },
    "autofocus": {
      "type": "string",
      "description": "focus the trigger on first render disabled, readonly  - non-interactive states"
    },
    "base-color": {
      "type": "string"
    },
    "bg-color": {
      "type": "string"
    },
    "border": {
      "type": "boolean",
      "default": false
    },
    "center-affix": {
      "type": "string",
      "description": "vertically center the affixes/icons"
    },
    "chips": {
      "type": "boolean",
      "default": false,
      "description": "render selections as chips (implied by multiple)"
    },
    "clear-icon": {
      "type": "string",
      "description": "icon name/glyph for the clear button"
    },
    "clearable": {
      "type": "boolean",
      "default": false,
      "description": "show a clear (×) button"
    },
    "closable-chips": {
      "type": "string",
      "description": "chips show a remove button"
    },
    "close-text": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "counter": {
      "type": "number",
      "description": "selection counter; a number sets the maximum shown"
    },
    "density": {
      "type": "string"
    },
    "disabled": {
      "type": "boolean",
      "default": false
    },
    "elevation": {
      "type": "number"
    },
    "error": {
      "type": "string"
    },
    "error-messages": {
      "type": "string",
      "description": "error messages (string, or JSON array); sets the error state"
    },
    "filter-keys": {
      "type": "string",
      "description": "item keys the search runs against"
    },
    "filter-mode": {
      "type": "enum",
      "values": [
        "some",
        "union"
      ],
      "description": "some | union (any key) | every | intersection (all keys)"
    },
    "flat": {
      "type": "boolean",
      "default": false,
      "description": "drop the elevation of the solo variants"
    },
    "glow": {
      "type": "string",
      "description": "light up the icons while the field is focused"
    },
    "height": {
      "type": "string"
    },
    "hide-details": {
      "type": "boolean",
      "default": false,
      "description": "suppress the details row (`auto` == the default)"
    },
    "hide-no-data": {
      "type": "string",
      "description": "suppress that message"
    },
    "hide-selected": {
      "type": "string",
      "description": "hide already-selected options"
    },
    "hint": {
      "type": "string"
    },
    "hover-elevation": {
      "type": "number"
    },
    "icon-color": {
      "type": "string",
      "description": "color for the affix icons and the menu icon prefix, suffix      - static text inside the control"
    },
    "icon-set": {
      "type": "string",
      "description": "icon set prefix for every *-icon attribute"
    },
    "indent-details": {
      "type": "string",
      "description": "inset the details row"
    },
    "item": {
      "type": "string",
      "description": "title/item-value - keys read from object items"
    },
    "item-color": {
      "type": "string",
      "description": "color of the selected items"
    },
    "item-title": {
      "type": "string"
    },
    "item-value": {
      "type": "string"
    },
    "items": {
      "type": "string",
      "description": "options as CSV or a JSON array (alternative to <w-option>)"
    },
    "label": {
      "type": "string"
    },
    "loading": {
      "type": "boolean",
      "default": false
    },
    "location": {
      "type": "string"
    },
    "max-errors": {
      "type": "number",
      "description": "how many error messages to show (default 1)"
    },
    "max-height": {
      "type": "number"
    },
    "max-width": {
      "type": "number"
    },
    "menu": {
      "type": "string",
      "description": "render with the menu already open"
    },
    "menu-elevation": {
      "type": "number",
      "description": "elevation step for the menu"
    },
    "menu-icon": {
      "type": "string",
      "description": "menu (chevron) icon; `false` hides it"
    },
    "messages": {
      "type": "string",
      "description": "extra messages (string, or JSON array of strings)"
    },
    "min-height": {
      "type": "number"
    },
    "min-width": {
      "type": "number"
    },
    "multiple": {
      "type": "boolean",
      "default": false,
      "description": "allow multiple selections"
    },
    "name": {
      "type": "string",
      "description": "form field name (renders a hidden input)"
    },
    "no-auto-scroll": {
      "type": "string",
      "description": "do not scroll the active item into view"
    },
    "no-data-text": {
      "type": "string",
      "description": "message shown when no option is visible"
    },
    "no-filter": {
      "type": "string",
      "description": "disable `search` filtering"
    },
    "open": {
      "type": "string",
      "description": "text/close-text - aria-label + title while the menu is open / closed"
    },
    "open-on-clear": {
      "type": "string",
      "description": "keep/open the menu after clearing"
    },
    "open-text": {
      "type": "string"
    },
    "persistent-clear": {
      "type": "string",
      "description": "keep the clear button visible while empty"
    },
    "persistent-counter": {
      "type": "number",
      "description": "keep the counter visible while empty and unfocused"
    },
    "persistent-hint": {
      "type": "string",
      "description": "keep the hint visible alongside an error"
    },
    "persistent-placeholder": {
      "type": "string",
      "description": "show the placeholder even when a value is selected label, hint, error  - field label / helper / error text"
    },
    "placeholder": {
      "type": "string",
      "description": "text shown when nothing is selected"
    },
    "position": {
      "type": "string"
    },
    "prefix": {
      "type": "string"
    },
    "prepend": {
      "type": "string",
      "description": "icon, append-icon             - icons outside the control"
    },
    "prepend-icon": {
      "type": "string"
    },
    "prepend-inner": {
      "type": "string",
      "description": "icon, append-inner-icon - icons inside the control"
    },
    "prepend-inner-icon": {
      "type": "string"
    },
    "readonly": {
      "type": "boolean",
      "default": false
    },
    "return-object": {
      "type": "string",
      "description": "`change` reports the item object instead of its value"
    },
    "reverse": {
      "type": "string",
      "description": "reverse the control's horizontal order"
    },
    "rounded": {
      "type": "boolean",
      "default": false
    },
    "search": {
      "type": "string",
      "description": "filter the options by this text"
    },
    "single-line": {
      "type": "string",
      "description": "no label above the control; it becomes the placeholder"
    },
    "size": {
      "type": "enum",
      "values": [
        "xs",
        "sm",
        "lg",
        "xl"
      ],
      "description": "xs | sm | lg | xl"
    },
    "solo": {
      "type": "enum",
      "values": [
        "filled",
        "solo-inverted"
      ],
      "description": "filled | solo-inverted"
    },
    "suffix": {
      "type": "string"
    },
    "theme": {
      "type": "string"
    },
    "tile": {
      "type": "boolean",
      "default": false
    },
    "transition": {
      "type": "enum",
      "values": [
        "fade",
        "scale",
        "slide-y"
      ],
      "description": "fade | scale | slide-y | slide-x menu transition"
    },
    "validate-on": {
      "type": "string",
      "description": "`lazy` withholds errors until the user interacts; a `blur` token makes blur (not selection) the trigger"
    },
    "value": {
      "type": "string",
      "description": "selected value (comma-joined when multiple)"
    },
    "variant": {
      "type": "enum",
      "values": [
        "outlined",
        "filled",
        "underlined",
        "plain",
        "solo"
      ],
      "description": "outlined | filled | underlined | plain | solo |"
    },
    "width": {
      "type": "string"
    }
  },
  "events": [
    {
      "name": "change",
      "detail": "object"
    }
  ],
  "slots": [
    "default"
  ],
  "source": "src/components/select.js",
  "inheritsFrom": [
    "src/components/base.js"
  ],
  "inheritedProps": []
}
