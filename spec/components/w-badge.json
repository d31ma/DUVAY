{
  "$description": "DuVay Badge — Core contract, tier 1.",
  "name": "Badge",
  "tier": 1,
  "names": {
    "web": "w-badge",
    "apple": "DuVayBadge",
    "android": "DuVayBadge",
    "windows": "DuVayInfoBadge",
    "linux": "duvay_badge"
  },
  "accessibility": {
    "role": "status",
    "nameFrom": [
      "label",
      "text",
      "slotted content",
      "aria-label"
    ]
  },
  "states": [
    "default",
    "hover",
    "focus-visible",
    "pressed",
    "disabled",
    "loading",
    "readonly",
    "error"
  ],
  "props": {
    "active": {
      "type": "boolean",
      "default": false,
      "description": "false hides only the badge bubble"
    },
    "active-color": {
      "type": "string"
    },
    "base-color": {
      "type": "string"
    },
    "bg-color": {
      "type": "string"
    },
    "border": {
      "type": "boolean",
      "default": false
    },
    "bordered": {
      "type": "string",
      "description": "adds a surface outline around the badge"
    },
    "color": {
      "type": "enum",
      "values": [
        "primary",
        "success",
        "danger",
        "warning",
        "info",
        "secondary",
        "tertiary"
      ],
      "description": "primary | success | danger | warning | info | secondary | tertiary"
    },
    "content": {
      "type": "string",
      "description": "badge bubble text"
    },
    "density": {
      "type": "string"
    },
    "disabled": {
      "type": "boolean",
      "default": false
    },
    "dot": {
      "type": "string",
      "description": "renders a dot badge"
    },
    "dot-size": {
      "type": "number",
      "description": "CSS length or number for dot badges"
    },
    "elevation": {
      "type": "number"
    },
    "floating": {
      "type": "string",
      "description": "offsets the badge outside wrapped content"
    },
    "height": {
      "type": "string"
    },
    "hover-elevation": {
      "type": "number"
    },
    "icon": {
      "type": "string",
      "description": "badge bubble icon text / glyph"
    },
    "inline": {
      "type": "string",
      "description": "renders as an inline badge instead of wrapping content"
    },
    "label": {
      "type": "string",
      "description": "aria label text, or boolean uppercase label styling"
    },
    "loading": {
      "type": "boolean",
      "default": false
    },
    "location": {
      "type": "enum",
      "values": [
        "top-end",
        "top-start",
        "bottom-end",
        "bottom-start"
      ],
      "description": "top-end | top-start | bottom-end | bottom-start"
    },
    "max": {
      "type": "number",
      "description": "caps numeric content as \"max+\""
    },
    "max-height": {
      "type": "number"
    },
    "max-width": {
      "type": "number"
    },
    "min-height": {
      "type": "number"
    },
    "min-width": {
      "type": "number"
    },
    "model-value": {
      "type": "string",
      "description": "Vuetify alias for active; false hides the badge bubble"
    },
    "offset": {
      "type": "string",
      "description": "x/y   - extra badge offset"
    },
    "offset-x": {
      "type": "string"
    },
    "offset-y": {
      "type": "string"
    },
    "position": {
      "type": "string"
    },
    "readonly": {
      "type": "boolean",
      "default": false
    },
    "rounded": {
      "type": "boolean",
      "default": false,
      "description": "true | pill | sm | md | lg | xl | 0 | none"
    },
    "text-color": {
      "type": "string",
      "description": "token color for badge text"
    },
    "theme": {
      "type": "string"
    },
    "tile": {
      "type": "boolean",
      "default": false
    },
    "transition": {
      "type": "enum",
      "values": [
        "scale",
        "slide-y"
      ],
      "description": "entry transition for the bubble: fade | scale | slide-y, or false/none to disable it"
    },
    "variant": {
      "type": "string"
    },
    "width": {
      "type": "string"
    }
  },
  "events": [],
  "slots": [
    "default",
    "badge"
  ],
  "source": "src/components/badge.js",
  "inheritsFrom": [
    "src/components/base.js"
  ],
  "inheritedProps": []
