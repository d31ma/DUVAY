{
  "$description": "DuVay Autocomplete — Core contract, tier 2.",
  "name": "Autocomplete",
  "tier": 2,
  "names": {
    "web": "w-autocomplete",
    "apple": "DuVayAutocomplete",
    "android": "DuVayAutocomplete",
    "windows": "DuVayAutoSuggestBox",
    "linux": "duvay_autocomplete"
  },
  "accessibility": {
    "role": "combobox",
    "nameFrom": [
      "label",
      "text",
      "slotted content",
      "aria-label"
    ]
  },
  "states": [
    "default",
    "hover",
    "focus-visible",
    "pressed",
    "disabled",
    "loading",
    "readonly",
    "error"
  ],
  "props": {
    "active": {
      "type": "boolean",
      "default": false
    },
    "active-color": {
      "type": "string"
    },
    "append-icon": {
      "type": "string"
    },
    "append-inner-icon": {
      "type": "string"
    },
    "auto-select-first": {
      "type": "string",
      "description": "highlight the first filtered result automatically"
    },
    "autocomplete": {
      "type": "string"
    },
    "autofocus": {
      "type": "string"
    },
    "base-color": {
      "type": "string"
    },
    "bg-color": {
      "type": "string"
    },
    "border": {
      "type": "boolean",
      "default": false
    },
    "center-affix": {
      "type": "string"
    },
    "chips": {
      "type": "boolean",
      "default": false,
      "description": "display selected values as chips"
    },
    "clear-icon": {
      "type": "string"
    },
    "clear-on-select": {
      "type": "string"
    },
    "clearable": {
      "type": "boolean",
      "default": false,
      "description": "show a clear button"
    },
    "closable-chips": {
      "type": "string",
      "description": "chips can be removed"
    },
    "close-text": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "counter": {
      "type": "number"
    },
    "density": {
      "type": "string"
    },
    "disabled": {
      "type": "boolean",
      "default": false,
      "description": "disables the control"
    },
    "elevation": {
      "type": "number"
    },
    "error": {
      "type": "string",
      "description": "error text and error state"
    },
    "error-messages": {
      "type": "string"
    },
    "filter-keys": {
      "type": "string"
    },
    "filter-mode": {
      "type": "string"
    },
    "flat": {
      "type": "boolean",
      "default": false
    },
    "glow": {
      "type": "string"
    },
    "height": {
      "type": "string"
    },
    "hide-details": {
      "type": "boolean",
      "default": false
    },
    "hide-no-data": {
      "type": "string",
      "description": "suppress the no-data message entirely"
    },
    "hide-selected": {
      "type": "string",
      "description": "hide already-selected items from the list (useful with multiple)"
    },
    "hide-spin-buttons": {
      "type": "string"
    },
    "hint": {
      "type": "string",
      "description": "helper text below the field"
    },
    "hover-elevation": {
      "type": "number"
    },
    "icon-color": {
      "type": "string"
    },
    "indent-details": {
      "type": "string"
    },
    "item-color": {
      "type": "string"
    },
    "item-title": {
      "type": "string",
      "description": "property to display for object items (default: title)"
    },
    "item-value": {
      "type": "string",
      "description": "property to use as the value for object items (default: value)"
    },
    "items": {
      "type": "string",
      "description": "comma-separated strings or JSON array of objects"
    },
    "label": {
      "type": "string",
      "description": "field label"
    },
    "loading": {
      "type": "boolean",
      "default": false,
      "description": "show a loading spinner"
    },
    "location": {
      "type": "string"
    },
    "max-errors": {
      "type": "number"
    },
    "max-height": {
      "type": "number"
    },
    "max-width": {
      "type": "number"
    },
    "menu": {
      "type": "string",
      "description": "alias of `open`"
    },
    "menu-elevation": {
      "type": "number"
    },
    "menu-icon": {
      "type": "string"
    },
    "messages": {
      "type": "string"
    },
    "min-height": {
      "type": "number"
    },
    "min-width": {
      "type": "number"
    },
    "multiple": {
      "type": "boolean",
      "default": false,
      "description": "allow multiple selections"
    },
    "name": {
      "type": "string",
      "description": "form field name (renders a hidden input)"
    },
    "no-auto-scroll": {
      "type": "string"
    },
    "no-data-text": {
      "type": "string",
      "description": "message shown when no items match (default: No data available)"
    },
    "no-filter": {
      "type": "string",
      "description": "disable local filtering (useful with server-side search)"
    },
    "open": {
      "type": "string",
      "description": "opens the dropdown list"
    },
    "open-on-clear": {
      "type": "string"
    },
    "open-text": {
      "type": "string"
    },
    "persistent-clear": {
      "type": "string"
    },
    "persistent-counter": {
      "type": "number"
    },
    "persistent-hint": {
      "type": "string"
    },
    "persistent-placeholder": {
      "type": "string"
    },
    "placeholder": {
      "type": "string",
      "description": "input placeholder"
    },
    "position": {
      "type": "string"
    },
    "prefix": {
      "type": "string"
    },
    "prepend-icon": {
      "type": "string"
    },
    "prepend-inner-icon": {
      "type": "string"
    },
    "readonly": {
      "type": "boolean",
      "default": false,
      "description": "prevents editing and opening the list"
    },
    "return-object": {
      "type": "string"
    },
    "reverse": {
      "type": "string"
    },
    "rounded": {
      "type": "boolean",
      "default": false
    },
    "search": {
      "type": "string"
    },
    "single-line": {
      "type": "string"
    },
    "size": {
      "type": "enum",
      "values": [
        "xs",
        "sm",
        "lg",
        "xl"
      ],
      "description": "xs | sm | lg | xl"
    },
    "suffix": {
      "type": "string"
    },
    "theme": {
      "type": "string"
    },
    "tile": {
      "type": "boolean",
      "default": false
    },
    "type": {
      "type": "string"
    },
    "validate-on": {
      "type": "string"
    },
    "value": {
      "type": "string",
      "description": "selected value(s); comma-separated when multiple"
    },
    "variant": {
      "type": "string"
    },
    "width": {
      "type": "string"
    }
  },
  "events": [
    {
      "name": "change",
      "detail": "object"
    },
    {
      "name": "input",
      "detail": "object"
    }
  ],
  "slots": [
    "default"
  ],
  "source": "src/components/autocomplete.js",
  "inheritsFrom": [
    "src/components/base.js"
  ],
  "inheritedProps": []
}
