  "$statusNote": "What each platform CLAIMS. scripts/platform-parity.mjs fails if a claim exceeds what is actually implemented on disk. 'tier-1-code-complete' means every tier-1 component exists and builds; 'tier-1-complete' additionally requires the manual screen-reader pass and snapshot suite the plan mandates, and only that may be advertised as support.",
  "status": {
    "web": "tier-2-complete",
    "apple": "tier-2-code-complete",
    "android": "tier-2-code-complete",
    "windows": "tier-2-code-complete",
    "linux": "tier-2-code-complete"
  },
