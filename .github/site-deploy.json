{
  "appId": "d13l2hvm60wv12",
  "region": "ca-central-1",
  "domain": "duvay.del.ma",
  "roles": {
    "staging": "arn:aws:iam::117469679339:role/duvay-site-deploy-staging",
    "production": "arn:aws:iam::117469679339:role/duvay-site-deploy-production"
  },
  "requiredHeaders": {},
  "probes": [
    { "path": "/", "contains": "DuVay", "contentTypes": ["text/html"] },
    { "path": "/docs/", "contains": "DuVay", "contentTypes": ["text/html"] },
    { "path": "/docs/release-notes/", "contains": "DuVay", "contentTypes": ["text/html"] },
    { "path": "/.tachyon/tac-client.js", "contains": "tachyon-view", "contentTypes": ["text/javascript", "application/javascript"] },
    { "path": "/shared/styles/app.css", "contains": "--w-border", "contentTypes": ["text/css"] }
  ]
}
