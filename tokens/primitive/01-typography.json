{
  "$description": "Typography",
  "$extensions": {
    "duvay": {
      "target": "src/tokens.css",
      "order": 1,
      "header": [
        "/* DuVay — Design tokens",
        " *",
        " * Single source of truth for typography, spacing, shape, layout, elevation,",
        " * and motion. Every value the framework paints with is exposed here so",
        " * consumers can theme without touching component CSS.",
        " *",
        " * Naming: --w-<category>-<name>. Spacing exposes both a numeric scale",
        " * (1, 2, 3, …, 20 — 4px steps) and a t-shirt scale (xs/sm/md/lg/xl/2xl/3xl).",
        " * Pick either; the t-shirt names are aliases of the numeric scale.",
        " */",
        "",
        "/* Token changelog — 2026-08-01",
        " * --w-command-*: command palette sizing, overlay offset, and compact text gap.",
        " * --w-highlight-opacity: default highlight wash strength.",
        " * --w-heatmap-hover-scale: hover emphasis for heatmap cells.",
        " * --w-pie-size / --w-pie-hover-scale: pie chart geometry and hover emphasis.",
        " * --w-video-*-width: seek and volume control sizing.",
        " * Affected components: command palette, highlight, heatmap, pie, and video.",
        " *",
        " * Token changelog — 2026-07-26",
        " * --w-font-xs: raised to the 0.75rem legibility floor; affects compact labels,",
        " *   buttons, tabs, text fields, switches, and pagination.",
        " * --w-type-label-small-size: raised to the same floor; affects small label",
        " *   typography utilities at every responsive tier.",
        " * --w-touch-min: expressed in rem while retaining a 44 CSS-pixel default;",
        " *   affects interactive controls that opt into the shared touch target.",
        " * --w-icon-glyph-{xs,sm,md,lg,xl}: added as the shared icon-button glyph",
        " *   scale; affects named sizes and the default glyph fallback in .w-icon-btn.",
        " */",
        ""
      ],
      "open": [
        ":root {"
      ],
      "banner": "  /* ── Typography ─────────────────────────────────────────────────────── */",
      "after": [
        ""
      ]
    }
  },
