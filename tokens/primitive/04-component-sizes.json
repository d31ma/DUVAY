{
  "$description": "Component sizes",
  "$extensions": {
    "duvay": {
      "target": "src/tokens.css",
      "order": 4,
      "banner": "  /* ── Component sizes ────────────────────────────────────────────────── */",
      "after": [
        ""
      ]
    }
  },
  "touch-min": {
    "$value": "2.75rem",
    "$type": "dimension",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1,
        "before": [
          "  /* Minimum accessible touch target (44 CSS px at the default root size). */"
        ]
      }
    }
  },
  "size-xs": {
    "$value": "28px",
    "$type": "dimension",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1,
        "before": [
          "",
          "  /* Button / input / icon heights. The default 40px maps to the t-shirt",
          "     medium scale; xs/sm/lg/xl extend it for density variants. */"
        ]
      }
    }
  },
  "size-sm": {
    "$value": "32px",
    "$type": "dimension",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1
      }
    }
  },
  "size-md": {
    "$value": "40px",
    "$type": "dimension",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1
      }
    }
  },
  "size-lg": {
    "$value": "48px",
    "$type": "dimension",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1
      }
    }
  },
  "size-xl": {
