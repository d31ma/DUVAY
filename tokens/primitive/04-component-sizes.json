      "duvay": {
        "indent": "  ",
        "pad": 1,
        "before": [
          "",
          "  /* Icon-only square controls (icon buttons, FABs, color swatches). */"
        ]
      }
    }
  },
  "size-icon-sm": {
    "$value": "32px",
    "$type": "dimension",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1
