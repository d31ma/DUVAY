{
  "$description": "compact density on a coarse pointer",
  "$extensions": {
    "duvay": {
      "target": "src/density.css",
      "order": 3,
      "density": "compact-coarse",
      "before": [
        "",
        "/* Compact is a pointer density. On a coarse pointer \u2014 touch, pen, a TV",
        " * remote \u2014 it falls back to the comfortable scale rather than shrinking",
        " * hit targets on a surface that cannot afford it.",
        " *",
        " * Compact's 32px controls do clear the 24px WCAG 2.5.8 AA minimum on their",
        " * own, so this is not an AA fix; it restores the 44px HIG / Material",
        " * recommendation, which is the figure that actually matters for touch.",
        " * The visual scale has to come back with it: .w-btn and friends size from",
        " * --w-size-*, so restoring --w-touch-min alone would leave a 32px button",
        " * with a 44px hit area overlapping its neighbours.",
        " *",
        " * Consequence worth knowing: setting w-density=\"compact\" on a phone is a",
        " * no-op. That is the intent \u2014 compact cannot be used to defeat the touch",
        " * floor by accident. */"
      ],
      "open": [
        "@media (pointer: coarse) {",
        "  [w-density=\"compact\"] {"
      ],
      "close": [
        "  }",
        "}"
      ],
      "trailer": [
        ""
      ]
    }
  },
  "size-xs": {
    "$value": "28px",
    "$type": "dimension",
    "$extensions": {
      "duvay": {
        "indent": "    ",
        "pad": 12
      }
    }
  },
  "size-sm": {
    "$value": "32px",
    "$type": "dimension",
    "$extensions": {
      "duvay": {
        "indent": "    ",
        "pad": 12
      }
    }
  },
  "size-md": {
    "$value": "40px",
    "$type": "dimension",
    "$extensions": {
      "duvay": {
        "indent": "    ",
        "pad": 12
      }
    }
  },
  "size-lg": {
    "$value": "48px",
    "$type": "dimension",
    "$extensions": {
      "duvay": {
        "indent": "    ",
        "pad": 12
      }
    }
  },
  "size-xl": {
    "$value": "56px",
    "$type": "dimension",
    "$extensions": {
      "duvay": {
        "indent": "    ",
        "pad": 12
      }
    }
  },
  "size-icon-xs": {
    "$value": "28px",
    "$type": "dimension",
    "$extensions": {
      "duvay": {
        "indent": "    ",
        "pad": 7,
        "before": [
          ""
        ]
      }
    }
  },
  "size-icon-sm": {
    "$value": "32px",
    "$type": "dimension",
    "$extensions": {
      "duvay": {
        "indent": "    ",
        "pad": 7
      }
    }
  },
  "size-icon-md": {
    "$value": "40px",
    "$type": "dimension",
    "$extensions": {
      "duvay": {
        "indent": "    ",
        "pad": 7
      }
    }
  },
  "size-icon-lg": {
    "$value": "48px",
    "$type": "dimension",
    "$extensions": {
      "duvay": {
        "indent": "    ",
        "pad": 7
      }
    }
  },
  "size-icon-xl": {
    "$value": "56px",
    "$type": "dimension",
    "$extensions": {
      "duvay": {
        "indent": "    ",
        "pad": 7
      }
    }
  },
  "touch-min": {
    "$value": "2.75rem",
    "$type": "dimension",
    "$extensions": {
      "duvay": {
        "indent": "    ",
        "pad": 10,
        "before": [
          ""
        ],
        "trail": "   /* back to the 44px touch floor */"
      }
    }
  }
}
