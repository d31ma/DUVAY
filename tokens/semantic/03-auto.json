  },
  "accent": {
    "$value": "#83cde3",
    "$type": "color",
    "$extensions": {
      "duvay": {
        "indent": "    ",
        "pad": 18,
        "before": [
          "",
          "  /* Accent — split into fill and text roles (libadwaita model).",
          "   * --w-accent-bg / --w-on-accent: accent fill and its label (>= 4.5:1).",
          "   * --w-accent: accent-coloured text drawn on a surface (>= 4.5:1).",
          "   * Conflating the two is the most common a11y failure in themed systems;",
          "   * native platforms also supply them separately (system accent). */"
        ]
      }
    }
  },
  "accent-bg": {
    "$value": "#83cde3",
