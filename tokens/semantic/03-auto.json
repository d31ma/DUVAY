{
  "$description": "auto theme",
  "$extensions": {
    "duvay": {
      "target": "src/themes.css",
      "order": 3,
      "theme": "auto",
      "open": [
        "@media (prefers-color-scheme: dark) {",
        "  [w-theme=\"auto\"] {"
      ],
      "close": [
        "  }",
        "}"
      ],
      "before": [
        "",
        "/* ── Auto: follows system preference ─────────────────────────────────── */",
        "/* The light values are inherited from :root; only re-apply dark values",
        " * when the user's OS is in dark mode. */"
      ],
      "after": [
        "",
        "    color-scheme: dark;"
      ]
    }
  },
  "highlight-color": {
    "$value": "var(--w-warning)",
    "$type": "reference",
    "$extensions": {
      "duvay": {
        "indent": "    ",
        "pad": 1,
        "before": [
          "    /* --w-highlight-color: semantic emphasis used by <w-highlight>. */"
        ]
      }
    }
  },
  "primary": {
    "$value": "#83cde3",
    "$type": "color",
    "$extensions": {
      "duvay": {
        "indent": "    ",
        "pad": 17
      }
    }
  },
  "on-primary": {
    "$value": "#08323f",
    "$type": "color",
    "$extensions": {
      "duvay": {
        "indent": "    ",
        "pad": 14
      }
    }
  },
  "primary-container": {
    "$value": "rgba(131, 205, 227, 0.18)",
    "$type": "color",
    "$extensions": {
      "duvay": {
