{
  "$description": "light theme",
  "$extensions": {
    "duvay": {
      "target": "src/themes.css",
      "order": 1,
      "theme": "light",
      "open": [
        ":root,",
        "[w-theme=\"light\"] {"
      ],
      "close": [
        "}"
      ],
      "before": [
        "/* DuVay — Theme system",
        " *",
        " * Themes redefine semantic color tokens. Components reference these by",
        " * name (e.g. var(--w-primary)) and never the underlying hex values.",
        " *",
        " * Themes are selected via the `w-theme` attribute on <html>:",
        " *   - light          (default)",
        " *   - dark",
        " *   - auto           (follows prefers-color-scheme)",
        " *   - high-contrast  (WCAG AAA-leaning palette)",
        " */",
        "",
        "/* ── Light theme (default) ──────────────────────────────────────────── */"
      ],
      "after": [
        "",
        "  color-scheme: light;"
      ]
    }
  },
  "highlight-color": {
    "$value": "var(--w-warning)",
    "$type": "reference",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1,
        "before": [
          "  /* --w-highlight-color: semantic emphasis used by <w-highlight>. */"
        ]
      }
    }
  },
  "primary": {
    "$value": "#1f6f8b",
    "$type": "color",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 17
      }
    }
  },
