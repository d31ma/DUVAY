{
  "$description": "high-contrast theme",
  "$extensions": {
    "duvay": {
      "target": "src/themes.css",
      "order": 4,
      "theme": "high-contrast",
      "open": [
        "[w-theme=\"high-contrast\"] {"
      ],
      "close": [
        "}"
      ],
      "before": [
        "",
        "/* ── High-contrast theme (accessibility) ─────────────────────────────── */",
        "/* WCAG AAA-leaning palette: stronger borders, near-pure surfaces, and",
        " * deep text. Works with either light or dark preference. */"
      ],
      "after": [
        "",
        "  color-scheme: light;"
      ],
      "trailer": [
        "",
        "/* Bump key borders so they remain visible at higher contrast. */",
        "[w-theme=\"high-contrast\"] :where(.w-card, .w-input, .w-select, .w-textarea, .w-btn-outlined, .w-chip, .w-badge, .w-command, .w-popover-content, .w-hover-card-content, .w-scroll-area, .w-resizable-panel, .w-input-group, .w-navigation-menu, .w-menubar, .w-sidebar-component) {",
        "  border-width: 2px;",
        "}",
        ""
      ]
    }
  },
  "highlight-color": {
    "$value": "var(--w-warning)",
    "$type": "reference",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1,
        "before": [
          "  /* --w-highlight-color: semantic emphasis used by <w-highlight>. */"
        ]
      }
    }
  },
