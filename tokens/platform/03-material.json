{
  "$description": "Platform tokens for the material skin.",
  "$extensions": {
    "duvay": {
      "target": "src/platforms/material.css",
      "order": 3,
      "selectors": [
        "[w-os=\"android\"]",
        "[w-os=\"material\"]"
      ],
      "open": [
        "[w-os=\"android\"],",
        "[w-os=\"material\"] {"
      ],
      "close": [
        "}"
      ],
      "entries": [
        {
          "kind": "comment",
          "text": "  /* Switch — set as inherited variables so this skin still wins"
        },
        {
          "kind": "comment",
          "text": "   * inside a page wearing a different one. */"
        },
        {
          "kind": "token",
          "name": "skin-switch-track-w"
        },
        {
          "kind": "token",
          "name": "skin-switch-track-h"
        },
        {
          "kind": "token",
          "name": "skin-switch-thumb"
        },
        {
          "kind": "token",
          "name": "skin-switch-pad"
        },
        {
          "kind": "blank"
        },
        {
          "kind": "comment",
          "text": "  /* ── Type ─────────────────────────────────────────────────────────── */"
        },
        {
          "kind": "token",
          "name": "font-family"
        },
        {
          "kind": "token",
          "name": "font-family-heading"
        },
        {
          "kind": "token",
          "name": "font-family-mono"
        },
        {
          "kind": "token",
          "name": "letter-spacing-normal"
        },
        {
          "kind": "token",
          "name": "line-height-normal"
        },
        {
          "kind": "blank"
        },
        {
          "kind": "token",
          "name": "topbar-height"
        },
        {
          "kind": "token",
          "name": "mobile-nav-height"
        },
        {
          "kind": "blank"
        },
        {
          "kind": "comment",
          "text": "  /* ── Elevation — M3 levels 1/3/5 ──────────────────────────────────── */"
        },
        {
          "kind": "token",
          "name": "shadow-sm"
        },
        {
          "kind": "token",
          "name": "shadow-md"
        },
        {
          "kind": "token",
          "name": "shadow-lg"
        },
        {
          "kind": "blank"
        },
        {
          "kind": "comment",
          "text": "  /* ── Motion — M3 Expressive emphasised easing ─────────────────────── */"
        },
        {
          "kind": "token",
          "name": "motion-ease-standard"
        },
        {
          "kind": "token",
          "name": "motion-ease-enter"
        },
        {
          "kind": "token",
          "name": "motion-ease-exit"
        },
        {
          "kind": "token",
          "name": "motion-duration-fast"
        },
        {
          "kind": "token",
          "name": "motion-duration"
        },
        {
          "kind": "token",
          "name": "motion-duration-slow"
        },
        {
          "kind": "token",
          "name": "transition-fast"
        },
        {
          "kind": "token",
          "name": "transition-normal"
        },
        {
          "kind": "token",
          "name": "transition-slow"
        },
        {
          "kind": "blank"
        },
        {
          "kind": "comment",
          "text": "  /* Focus — M3's ring is thicker and sits closer to the control. */"
        },
        {
          "kind": "token",
          "name": "focus-ring-width"
        },
        {
          "kind": "token",
          "name": "focus-ring-color"
        },
        {
          "kind": "blank"
        }
      ]
    }
  },
  "skin-switch-track-w": {
    "$value": "52px",
    "$type": "dimension",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1,
        "trail": ""
      }
    }
  },
  "skin-switch-track-h": {
    "$value": "32px",
    "$type": "dimension",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1,
        "trail": ""
      }
    }
  },
  "skin-switch-thumb": {
    "$value": "24px",
    "$type": "dimension",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1,
        "trail": ""
      }
    }
  },
  "skin-switch-pad": {
    "$value": "4px",
    "$type": "dimension",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1,
        "trail": ""
      }
    }
  },
  "font-family": {
    "$value": "Roboto, 'Roboto Flex', 'Noto Sans', system-ui, sans-serif",
    "$type": "fontFamily",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1,
        "trail": ""
      }
    }
  },
  "font-family-heading": {
    "$value": "Roboto, 'Roboto Flex', system-ui, sans-serif",
    "$type": "fontFamily",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1,
        "trail": ""
      }
    }
  },
  "font-family-mono": {
    "$value": "'Roboto Mono', ui-monospace, monospace",
    "$type": "fontFamily",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1,
        "trail": ""
      }
    }
  },
  "letter-spacing-normal": {
    "$value": "0.00625em",
    "$type": "dimension",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1,
        "trail": ""
      }
    }
  },
  "line-height-normal": {
    "$value": "1.43",
    "$type": "number",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1,
        "trail": ""
      }
    }
  },
  "topbar-height": {
    "$value": "64px",
    "$type": "dimension",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1,
        "trail": ""
      }
    }
  },
  "mobile-nav-height": {
    "$value": "80px",
    "$type": "dimension",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1,
        "trail": "       /* M3 navigation bar */"
      }
    }
  },
  "shadow-sm": {
    "$value": "0 1px 2px var(--w-shadow-color), 0 1px 3px 1px var(--w-shadow-color)",
    "$type": "shadow",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1,
        "trail": ""
      }
    }
  },
  "shadow-md": {
    "$value": "0 4px 8px 3px var(--w-shadow-color), 0 1px 3px var(--w-shadow-color)",
    "$type": "shadow",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1,
        "trail": ""
      }
    }
  },
  "shadow-lg": {
    "$value": "0 8px 12px 6px var(--w-shadow-color), 0 4px 4px var(--w-shadow-color)",
    "$type": "shadow",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1,
        "trail": ""
      }
    }
  },
  "motion-ease-standard": {
    "$value": "cubic-bezier(0.2, 0, 0, 1)",
    "$type": "cubicBezier",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1,
        "trail": ""
      }
    }
  },
  "motion-ease-enter": {
    "$value": "cubic-bezier(0.05, 0.7, 0.1, 1)",
    "$type": "cubicBezier",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 4,
        "trail": ""
      }
    }
  },
  "motion-ease-exit": {
    "$value": "cubic-bezier(0.3, 0, 0.8, 0.15)",
    "$type": "cubicBezier",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 5,
        "trail": ""
      }
    }
  },
  "motion-duration-fast": {
    "$value": "200ms",
    "$type": "duration",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1,
        "trail": ""
      }
    }
  },
  "motion-duration": {
    "$value": "300ms",
    "$type": "duration",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 6,
        "trail": ""
      }
    }
  },
  "motion-duration-slow": {
    "$value": "500ms",
    "$type": "duration",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1,
        "trail": ""
      }
    }
  },
  "transition-fast": {
    "$value": "200ms cubic-bezier(0.2, 0, 0, 1)",
    "$type": "other",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 3,
        "trail": ""
      }
    }
  },
  "transition-normal": {
    "$value": "300ms cubic-bezier(0.2, 0, 0, 1)",
    "$type": "other",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1,
        "trail": ""
      }
    }
  },
  "transition-slow": {
    "$value": "500ms cubic-bezier(0.2, 0, 0, 1)",
    "$type": "other",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 3,
        "trail": ""
      }
    }
  },
  "focus-ring-width": {
    "$value": "3px",
    "$type": "dimension",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1,
        "trail": ""
      }
    }
  },
  "focus-ring-color": {
    "$value": "var(--w-accent)",
    "$type": "reference",
    "$extensions": {
      "duvay": {
        "indent": "  ",
        "pad": 1,
        "trail": ""
      }
    }
  }
}
